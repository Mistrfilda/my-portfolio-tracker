{
  "compilerOptions": {
    "module": "esnext",
    "esModuleInterop": true,
    "target": "es6",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": false,
    "noImplicitAny": true,
    "moduleResolution": "bundler",
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "./assets",
    "typeRoots": ["./types", "./node_modules/@types"],
  },
  "include": ["assets/**/*.ts"],
  "exclude": ["vendor", "node_modules", "clients"]
}
