parameters:
	rabbitmq:
		user: appuser
		password: extremelysecretrabbit
		host: 192.168.1.245
		port: 31383
		lazy: true
		queues:
			notificationQueue:
				prefetchCount: 5
			jobRequestQueue:
				prefetchCount: 5
			aiClientsQueue:
				prefetchCount: 5

services:
	rabbitMQConnectionConfig: Mistrfilda\Amqp\RabbitMQConnectionConfig(%rabbitmq.host%, %rabbitmq.port%, %rabbitmq.user%, %rabbitmq.password%)
	rabbitMQConnectionFactory: Mistrfilda\Amqp\RabbitMQConnectionFactory
	rabbitMQPublisher: Mistrfilda\Amqp\PhpAmqpLibRabbitMQPublisher
	rabbitMQQueueConfigCollection: Mistrfilda\Amqp\RabbitMQQueueConfigCollection([
		Mistrfilda\Amqp\RabbitMQQueueConfig('notificationQueue', 'notificationConsumer', @notificationConsumer, %rabbitmq.queues.notificationQueue.prefetchCount%),
		Mistrfilda\Amqp\RabbitMQQueueConfig('jobRequestQueue', 'jobRequestConsumer', @jobRequestConsumer, %rabbitmq.queues.jobRequestQueue.prefetchCount%),
		Mistrfilda\Amqp\RabbitMQQueueConfig('aiClientsQueue', 'aiClientsConsumer', @aiClientsConsumer, %rabbitmq.queues.aiClientsQueue.prefetchCount%, requeueOnFailure: false),
	])
	rabbitMQQueueDeclarator: Mistrfilda\Amqp\RabbitMQQueueDeclarator
	rabbitMQConsumerRunner: Mistrfilda\Amqp\RabbitMQConsumerRunner
	- Mistrfilda\Amqp\RabbitMQDeclareQueuesCommand
	- Mistrfilda\Amqp\RabbitMQConsumerCommand
	notificationConsumer: App\Notification\RabbitMQ\NotificationConsumer
	notificationProducer: App\Notification\RabbitMQ\NotificationProducer(@rabbitMQPublisher, 'notificationQueue')
	jobRequestConsumer: App\JobRequest\RabbitMQ\JobRequestConsumer
	jobRequestProducer: App\JobRequest\RabbitMQ\JobRequestProducer(@rabbitMQPublisher, 'jobRequestQueue')
	aiClientsConsumer: App\Stock\AiAnalysis\RabbitMQ\StockAiAnalysisGeminiProcessConsumer
	aiClientsProducer: App\Stock\AiAnalysis\RabbitMQ\StockAiAnalysisGeminiProcessProducer(@rabbitMQPublisher, 'aiClientsQueue')
