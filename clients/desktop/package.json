{
	"name": "@my-portfolio-tracker/desktop",
	"version": "0.1.0",
	"private": true,
	"description": "My Portfolio Tracker for macOS",
	"author": "My Portfolio Tracker",
	"type": "module",
	"main": "./out/main/index.js",
	"engines": {
		"node": ">=24 <25",
		"npm": ">=11.10.0 <12"
	},
	"scripts": {
		"dev": "electron-vite dev --watch",
		"dev:renderer": "vite --config vite.renderer.config.ts",
		"start": "electron-vite preview",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.test.json",
		"test": "vitest run",
		"check": "npm run lint && npm run format:check && npm run typecheck && npm test",
		"build": "electron-vite build",
		"pretest:smoke": "install-electron",
		"test:smoke": "playwright test",
		"package:mac": "env -u CSC_LINK -u CSC_KEY_PASSWORD -u CSC_NAME -u CSC_KEYCHAIN -u CSC_INSTALLER_LINK -u CSC_INSTALLER_KEY_PASSWORD CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --config electron-builder.yml --mac --arm64 --publish never"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@playwright/test": "1.64.0",
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "24.19.2",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "5.2.0",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"electron": "44.7.1",
		"electron-builder": "26.15.3",
		"electron-vite": "5.0.0",
		"eslint": "10.12.0",
		"eslint-plugin-react-hooks": "7.1.1",
		"eslint-plugin-react-refresh": "0.5.7",
		"lucide-react": "0.577.0",
		"prettier": "3.9.10",
		"radix-ui": "1.8.1",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-router": "7.18.4",
		"tailwind-merge": "3.7.0",
		"tailwindcss": "4.3.3",
		"tw-animate-css": "1.4.0",
		"typescript": "6.0.3",
		"typescript-eslint": "8.71.2",
		"vite": "7.3.7",
		"vitest": "4.1.11"
	}
}
