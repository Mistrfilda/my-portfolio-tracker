{templateType App\Stock\Valuation\Model\UI\Control\StockValuationModelTableControlTemplate}

{var $totalColumns = (count($tableControlItems) > 0 ? count($tableControlItems[0]->getModelResponses()) + 2 : 2)}

<div>
	<div class="mb-4 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
		<div>
			<h2 class="text-base font-semibold text-gray-900">Valuační modely</h2>
			<p class="mt-1 text-sm text-gray-500">
				Nejdřív souhrn za akcii, jednotlivé modely jsou dostupné po rozbalení.
			</p>
		</div>

		<label class="relative block">
			<span class="sr-only">Hledat akcii</span>
			<span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
				{renderSvg App\UI\Icon\SvgIcon::MAGNIFYING_GLASS->value, ['class' => 'size-4 text-gray-400']}
			</span>
			<input
				x-model.debounce.150ms="query"
				type="search"
				placeholder="Hledat akcii…"
				class="block w-full rounded-md border-0 py-2 pl-9 pr-3 text-sm text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-blue-600 sm:w-64"
			>
		</label>
	</div>

	{if count($tableControlItems) > 0}
		<div class="hidden grid-cols-[minmax(14rem,2fr)_repeat(4,minmax(8rem,1fr))_2.5rem] gap-4 border-b border-gray-200 px-4 pb-2 text-xs font-semibold uppercase tracking-wide text-gray-500 lg:grid sm:px-6">
			<div>Akcie</div>
			<div class="text-right">Aktuální cena</div>
			<div class="text-right">Konsenzus rodin</div>
			<div class="text-right">Odchylka</div>
			<div class="text-right">Pásmo Q1–Q3</div>
			<div></div>
		</div>

		<div class="max-h-[70vh] divide-y divide-gray-200 overflow-y-auto bg-white shadow-sm ring-1 ring-gray-900/5 sm:rounded-xl">
			{foreach $tableControlItems as $item}
				{var $stockAsset = $item->getStockAsset()}
				{var $modelConsensus = $item->getModelConsensus()}
				{var $consensusPrice = $modelConsensus->getPrice()}
				{var $consensusPercentage = $modelConsensus->getPercentage()}
				{var $lowerQuartilePercentage = $modelConsensus->getLowerQuartilePercentage()}
				{var $upperQuartilePercentage = $modelConsensus->getUpperQuartilePercentage()}

				<details
					x-show="matches($el.dataset.search)"
					x-cloak
					data-search="{$stockAsset->getName()} {$stockAsset->getTicker()}"
					class="group bg-white"
				>
					<summary class="grid cursor-pointer list-none grid-cols-2 gap-4 px-4 py-4 hover:bg-gray-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-blue-600 lg:grid-cols-[minmax(14rem,2fr)_repeat(4,minmax(8rem,1fr))_2.5rem] lg:items-center sm:px-6">
						<span class="col-span-2 min-w-0 lg:col-span-1">
							<span class="block truncate text-sm font-semibold text-gray-900">{$stockAsset->getName()}</span>
							<span class="mt-0.5 block text-xs text-gray-500">
								{$stockAsset->getTicker()} · modely {$modelConsensus->getValidModelsCount()}/{$modelConsensus->getTotalModelsCount()} · rodiny {$modelConsensus->getValidFamiliesCount()}/{$modelConsensus->getTotalFamiliesCount()}
							</span>
						</span>

						<span class="text-left lg:text-right">
							<span class="block text-xs text-gray-500 lg:hidden">Aktuální cena</span>
							<span class="mt-1 block text-sm font-medium text-gray-900 lg:mt-0">
								{$stockAsset->getAssetCurrentPrice()|assetPriceFormat}
							</span>
						</span>

						<span class="text-right">
							<span class="block text-xs text-gray-500 lg:hidden">Konsenzus rodin</span>
							<span class="mt-1 block text-sm font-semibold text-gray-900 lg:mt-0">
								{if $consensusPrice !== null}
									{$consensusPrice|assetPriceFormat}
								{else}
									<span class="font-normal text-gray-400">N/A</span>
								{/if}
							</span>
						</span>

						<span class="text-left lg:text-right">
							<span class="block text-xs text-gray-500 lg:hidden">Odchylka</span>
							<span
								n:class="'mt-1 text-sm font-semibold lg:mt-0', $consensusPercentage === null ? 'text-gray-400' : ($consensusPercentage > 0 ? 'text-green-700' : ($consensusPercentage < 0 ? 'text-red-700' : 'text-gray-700'))"
							>
								{if $consensusPercentage !== null}
									{if $consensusPercentage > 0}+{/if}{$consensusPercentage|number:2} %
								{else}
									N/A
								{/if}
							</span>
						</span>

						<span class="text-right">
							<span class="block text-xs text-gray-500 lg:hidden">Pásmo Q1–Q3</span>
							<span class="mt-1 block text-sm font-medium text-gray-900 lg:mt-0">
								{if $lowerQuartilePercentage !== null && $upperQuartilePercentage !== null}
									{if $lowerQuartilePercentage > 0}+{/if}{$lowerQuartilePercentage|number:1} až {if $upperQuartilePercentage > 0}+{/if}{$upperQuartilePercentage|number:1} %
								{else}
									<span class="font-normal text-gray-400">N/A</span>
								{/if}
							</span>
						</span>

						<span class="col-span-2 flex justify-end lg:col-span-1">
							<span class="rounded-md p-1.5 text-gray-400 transition group-open:rotate-180">
								{renderSvg App\UI\Icon\SvgIcon::CHEVRON_DOWN->value, ['class' => 'size-5']}
							</span>
						</span>
					</summary>

					<div class="border-t border-gray-100 bg-gray-50 px-4 py-5 sm:px-6">
						<div class="mb-5 overflow-hidden rounded-lg bg-white shadow-sm ring-1 ring-gray-900/5">
							<div class="flex flex-col gap-2 border-b border-gray-200 px-4 py-3 sm:flex-row sm:items-center sm:justify-between">
								<div>
									<h3 class="text-sm font-semibold text-gray-900">Diagnostika konsenzu</h3>
									<p class="mt-0.5 text-xs text-gray-500">Každá modelová rodina má ve výsledku stejnou váhu.</p>
								</div>
								<span class="inline-flex w-fit items-center rounded-full px-2.5 py-1 text-xs font-semibold ring-1 ring-inset {$modelConsensus->getConfidence()->getBadgeClasses()}">
									{$modelConsensus->getConfidence()->getLabel()}
								</span>
							</div>

							<dl class="grid grid-cols-2 divide-x divide-y divide-gray-200 lg:grid-cols-4 lg:divide-y-0">
								<div class="px-4 py-3">
									<dt class="text-xs text-gray-500">Konsenzus rodin</dt>
									<dd class="mt-1 text-sm font-semibold text-gray-900">
										{if $consensusPrice !== null}
											{$consensusPrice|assetPriceFormat}
										{else}
											N/A
										{/if}
									</dd>
								</div>
								<div class="px-4 py-3">
									<dt class="text-xs text-gray-500">Medián všech modelů</dt>
									<dd class="mt-1 text-sm font-semibold text-gray-900">
										{if $modelConsensus->getRawMedianPrice() !== null}
											{$modelConsensus->getRawMedianPrice()|assetPriceFormat}
										{else}
											N/A
										{/if}
									</dd>
								</div>
								<div class="px-4 py-3">
									<dt class="text-xs text-gray-500">Aritmetický průměr</dt>
									<dd class="mt-1 text-sm font-semibold text-gray-900">
										{if $modelConsensus->getArithmeticMeanPrice() !== null}
											{$modelConsensus->getArithmeticMeanPrice()|assetPriceFormat}
										{else}
											N/A
										{/if}
									</dd>
								</div>
								<div class="px-4 py-3">
									<dt class="text-xs text-gray-500">Rozptyl rodin</dt>
									<dd class="mt-1 text-sm font-semibold text-gray-900">
										{if $modelConsensus->getNormalizedIqrPercentage() !== null}
											IQR {$modelConsensus->getNormalizedIqrPercentage()|number:1} %
										{else}
											N/A
										{/if}
									</dd>
									{if $modelConsensus->getNormalizedMadPercentage() !== null}
										<div class="mt-0.5 text-xs text-gray-500">MAD {$modelConsensus->getNormalizedMadPercentage()|number:1} %</div>
									{/if}
								</div>
							</dl>

							<div class="border-t border-gray-200 px-4 py-4">
								<h4 class="text-xs font-semibold uppercase tracking-wide text-gray-500">Modelové rodiny</h4>
								<div class="mt-3 grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
									{foreach $modelConsensus->getFamilyEstimates() as $familyEstimate}
										<div class="rounded-md bg-gray-50 px-3 py-2.5">
											<div class="flex items-start justify-between gap-3">
												<div>
													<div class="text-xs font-medium text-gray-700">{$familyEstimate->getFamily()->getLabel()}</div>
													<div class="mt-0.5 text-xs text-gray-500">Modely {$familyEstimate->getValidModelsCount()}/{$familyEstimate->getTotalModelsCount()}</div>
												</div>
												<div class="text-right">
													{if $familyEstimate->getPrice() !== null}
														<div class="text-sm font-semibold text-gray-900">{$familyEstimate->getPrice()|assetPriceFormat}</div>
														{if $familyEstimate->getPercentage() !== null}
															<div n:class="'mt-0.5 text-xs font-medium', $familyEstimate->getPercentage() > 0 ? 'text-green-700' : ($familyEstimate->getPercentage() < 0 ? 'text-red-700' : 'text-gray-600')">
																{if $familyEstimate->getPercentage() > 0}+{/if}{$familyEstimate->getPercentage()|number:1} %
															</div>
														{/if}
													{else}
														<span class="text-sm text-gray-400">N/A</span>
													{/if}
												</div>
											</div>
										</div>
									{/foreach}
								</div>

								{if $modelConsensus->getOutlierCount() > 0}
									<p class="mt-3 text-xs text-amber-700">
										Extrémní výstup ({$modelConsensus->getOutlierCount()}):
										{foreach $modelConsensus->getOutlierModelLabels() as $outlierLabel}{$outlierLabel}{if !$iterator->last}, {/if}{/foreach}. Zůstává v diagnostice, ale nemá přímou váhu ve výsledku.
									</p>
								{/if}
							</div>
						</div>

						<div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
							{foreach $item->getModelResponses() as $modelResponse}
								{var $state = $modelResponse->getStockValuationModelTrend()}
								{var $color = $state->getTailwindColor()}
								{var $isCalculated = $state !== App\Stock\Valuation\Model\StockValuationModelState::UNABLE_TO_CALCULATE}

								<div class="rounded-lg bg-white p-4 ring-1 ring-inset ring-gray-200">
									<div class="flex items-start justify-between gap-3">
										<h3 class="text-sm font-medium text-gray-900">{$modelResponse->getLabel()}</h3>
										<span class="inline-flex shrink-0 items-center rounded-md bg-{$color}-50 px-2 py-1 text-xs font-medium text-{$color}-700 ring-1 ring-inset ring-{$color}-700/10">
											{$state->getLabel()}
										</span>
									</div>

									{if $isCalculated}
										<div class="mt-4 flex items-end justify-between gap-3">
											<div>
												<div class="text-xs text-gray-500">Férová cena</div>
												<div class="mt-1 font-semibold text-gray-900">
													{if $modelResponse->getAssetPrice() !== null}
														{$modelResponse->getAssetPrice()|assetPriceFormat}
													{else}
														N/A
													{/if}
												</div>
											</div>
											{if $modelResponse->getCalculatedPercentage() !== null}
												{var $percentage = $modelResponse->getCalculatedPercentage()}
												<span n:class="'text-sm font-semibold', $percentage > 0 ? 'text-green-700' : ($percentage < 0 ? 'text-red-700' : 'text-gray-700')">
													{if $percentage > 0}+{/if}{$percentage|number:2} %
												</span>
											{/if}
										</div>
									{else}
										<p class="mt-4 text-xs text-gray-500">Pro výpočet nejsou dostupná potřebná data.</p>
									{/if}
								</div>
							{/foreach}
						</div>

						<div class="mt-4 border-t border-gray-200 pt-4">
							<a
								href="{plink StockAssetDetail:detail, 'id' => $stockAsset->getId()->toString()}"
								class="text-sm font-semibold text-blue-600 hover:text-blue-500"
							>
								Otevřít kompletní detail akcie
								<span aria-hidden="true">→</span>
							</a>
						</div>
					</div>
				</details>
			{/foreach}
		</div>

		<details
			x-bind:open="matrixOpen"
			x-on:toggle="matrixOpen = $el.open"
			class="group mt-6 overflow-hidden rounded-xl bg-white shadow-sm ring-1 ring-gray-900/5"
		>
			<summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-4 py-4 hover:bg-gray-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-blue-600 sm:px-6">
				<span>
					<span class="block text-sm font-semibold text-gray-900">Pokročilá matice modelů</span>
					<span class="mt-1 block text-xs text-gray-500">Kompletní tabulka pro detailní porovnání a řazení jednotlivých modelů.</span>
				</span>
				<span class="shrink-0 text-gray-400 transition group-open:rotate-180">
					{renderSvg App\UI\Icon\SvgIcon::CHEVRON_DOWN->value, ['class' => 'size-5']}
				</span>
			</summary>

			<div class="border-t border-gray-200" x-data="stockValuationModelData({$totalColumns})">
				<div class="flex justify-end border-b border-gray-200 bg-gray-50 px-4 py-3 sm:px-6">
					<div
						x-on:keydown.escape.prevent.stop="close($refs.button)"
						x-on:focusin.window="!$refs.panel.contains($event.target) && close()"
						x-id="['valuation-column-picker']"
						class="relative"
					>
						<button
							x-ref="button"
							x-on:click="toggle()"
							:aria-expanded="open"
							:aria-controls="$id('valuation-column-picker')"
							type="button"
							class="inline-flex items-center gap-2 rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-700 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50"
						>
							Viditelné sloupce
							{renderSvg App\UI\Icon\SvgIcon::CHEVRON_DOWN->value, ['class' => 'size-4 text-gray-400']}
						</button>

						<div
							x-ref="panel"
							x-show="open"
							x-cloak
							x-transition.origin.top.right
							x-on:click.outside="close($refs.button)"
							:id="$id('valuation-column-picker')"
							class="absolute right-0 z-50 mt-2 max-h-96 w-72 overflow-y-auto rounded-md bg-white shadow-lg ring-1 ring-black/5"
						>
							<div class="flex gap-2 border-b border-gray-200 p-3">
								<button
									type="button"
									x-on:click="showAll()"
									class="flex-1 rounded bg-blue-50 px-3 py-1.5 text-xs font-medium text-blue-700 hover:bg-blue-100"
								>
									Zobrazit vše
								</button>
								<button
									type="button"
									x-on:click="hideAll()"
									class="flex-1 rounded bg-gray-100 px-3 py-1.5 text-xs font-medium text-gray-700 hover:bg-gray-200"
								>
									Skrýt vše
								</button>
							</div>

							<div class="py-1">
								<button
									type="button"
									x-on:click="toggleColumn(1)"
									:aria-pressed="!isHidden(1)"
									:class="isHidden(1) && 'bg-gray-100'"
									class="flex w-full items-center px-4 py-2 text-left text-sm text-gray-900 hover:bg-gray-100"
								>
									<span x-show="isHidden(1)">
										{renderSvg App\UI\Icon\SvgIcon::EYE_CLOSED->value, ['class' => 'mr-3 size-5 text-gray-400']}
									</span>
									<span x-show="!isHidden(1)">
										{renderSvg App\UI\Icon\SvgIcon::EYE->value, ['class' => 'mr-3 size-5 text-gray-400']}
									</span>
									Aktuální cena
								</button>

								{foreach $tableControlItems[0]->getModelResponses() as $model}
									{var $columnIndex = $iterator->counter + 1}
									<button
										type="button"
										x-on:click="toggleColumn({$columnIndex})"
										:aria-pressed="!isHidden({$columnIndex})"
										:class="isHidden({$columnIndex}) && 'bg-gray-100'"
										class="flex w-full items-center px-4 py-2 text-left text-sm text-gray-900 hover:bg-gray-100"
									>
										<span x-show="isHidden({$columnIndex})">
											{renderSvg App\UI\Icon\SvgIcon::EYE_CLOSED->value, ['class' => 'mr-3 size-5 text-gray-400']}
										</span>
										<span x-show="!isHidden({$columnIndex})">
											{renderSvg App\UI\Icon\SvgIcon::EYE->value, ['class' => 'mr-3 size-5 text-gray-400']}
										</span>
										<span class="truncate">{$model->getLabel()}</span>
									</button>
								{/foreach}
							</div>
						</div>
					</div>
				</div>

				<div class="relative max-h-[70vh] overflow-auto">
					<table class="min-w-max divide-y divide-gray-200">
						<thead class="bg-gray-50">
						<tr>
							<th scope="col" class="sticky left-0 top-0 z-30 min-w-56 bg-gray-50 px-6 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-500">
								<a
									href="{plink StockValuationModel:default sortBy: 'name', sortDirection: ($sortBy === 'name' && $sortDirection === 'asc') ? 'desc' : 'asc'}"
									class="ajax group flex items-center gap-x-1 hover:text-blue-600"
								>
									<span>Akcie</span>
									{if $sortBy === 'name'}
										{renderSvg ($sortDirection === 'asc' ? App\UI\Icon\SvgIcon::CHEVRON_UP : App\UI\Icon\SvgIcon::CHEVRON_DOWN)->value, ['class' => 'size-4 text-blue-500']}
									{else}
										{renderSvg App\UI\Icon\SvgIcon::CHEVRON_UP->value, ['class' => 'size-4 text-gray-300 group-hover:text-blue-400']}
									{/if}
								</a>
							</th>
							<th
								scope="col"
								:class="isHidden(1) && 'hidden'"
								class="sticky top-0 z-20 min-w-36 bg-gray-50 px-6 py-3 text-right text-xs font-semibold uppercase tracking-wide text-gray-500"
							>
								<a
									href="{plink StockValuationModel:default sortBy: 'current_price', sortDirection: ($sortBy === 'current_price' && $sortDirection === 'asc') ? 'desc' : 'asc'}"
									class="ajax group flex items-center justify-end gap-x-1 hover:text-blue-600"
								>
									<span>Aktuální cena</span>
									{if $sortBy === 'current_price'}
										{renderSvg ($sortDirection === 'asc' ? App\UI\Icon\SvgIcon::CHEVRON_UP : App\UI\Icon\SvgIcon::CHEVRON_DOWN)->value, ['class' => 'size-4 text-blue-500']}
									{else}
										{renderSvg App\UI\Icon\SvgIcon::CHEVRON_UP->value, ['class' => 'size-4 text-gray-300 group-hover:text-blue-400']}
									{/if}
								</a>
							</th>
							{foreach $tableControlItems[0]->getModelResponses() as $model}
								{var $modelIndex = $iterator->counter - 1}
								{var $modelSortKey = 'model_' . $modelIndex}
								{var $columnIndex = $iterator->counter + 1}
								<th
									scope="col"
									:class="isHidden({$columnIndex}) && 'hidden'"
									class="sticky top-0 z-20 min-w-44 bg-gray-50 px-6 py-3 text-center text-xs font-semibold uppercase tracking-wide text-gray-500"
								>
									<a
										href="{plink StockValuationModel:default sortBy: $modelSortKey, sortDirection: ($sortBy === $modelSortKey && $sortDirection === 'asc') ? 'desc' : 'asc'}"
										class="ajax group flex items-center justify-center gap-x-1 hover:text-blue-600"
									>
										<span>{$model->getLabel()}</span>
										{if $sortBy === $modelSortKey}
											{renderSvg ($sortDirection === 'asc' ? App\UI\Icon\SvgIcon::CHEVRON_UP : App\UI\Icon\SvgIcon::CHEVRON_DOWN)->value, ['class' => 'size-4 shrink-0 text-blue-500']}
										{else}
											{renderSvg App\UI\Icon\SvgIcon::CHEVRON_UP->value, ['class' => 'size-4 shrink-0 text-gray-300 group-hover:text-blue-400']}
										{/if}
									</a>
								</th>
							{/foreach}
						</tr>
						</thead>
						<tbody class="divide-y divide-gray-200 bg-white">
						{foreach $tableControlItems as $item}
							{var $stockAsset = $item->getStockAsset()}
							<tr class="group hover:bg-gray-50">
								<td class="sticky left-0 z-10 bg-white px-6 py-4 group-hover:bg-gray-50">
									<a
										href="{plink StockAssetDetail:detail, 'id' => $stockAsset->getId()->toString()}"
										class="block max-w-52 truncate font-medium text-gray-900 hover:text-blue-600"
									>
										{$stockAsset->getName()}
									</a>
									<div class="mt-0.5 text-xs text-gray-500">{$stockAsset->getTicker()}</div>
								</td>
								<td
									:class="isHidden(1) && 'hidden'"
									class="whitespace-nowrap px-6 py-4 text-right font-semibold text-gray-900"
								>
									{$stockAsset->getAssetCurrentPrice()|assetPriceFormat}
								</td>
								{foreach $item->getModelResponses() as $modelResponse}
									{var $columnIndex = $iterator->counter + 1}
									{var $state = $modelResponse->getStockValuationModelTrend()}
									{var $color = $state->getTailwindColor()}
									{var $isCalculated = $state !== App\Stock\Valuation\Model\StockValuationModelState::UNABLE_TO_CALCULATE}
									<td
										:class="isHidden({$columnIndex}) && 'hidden'"
										class="whitespace-nowrap px-6 py-4 text-center"
									>
										{if $isCalculated}
											<div class="font-semibold text-{$color}-700">
												{if $modelResponse->getAssetPrice() !== null}
													{$modelResponse->getAssetPrice()|assetPriceFormat}
												{else}
													N/A
												{/if}
											</div>
											{if $modelResponse->getCalculatedPercentage() !== null}
												{var $percentage = $modelResponse->getCalculatedPercentage()}
												<div n:class="'mt-1 text-xs font-semibold', $percentage > 0 ? 'text-green-700' : ($percentage < 0 ? 'text-red-700' : 'text-gray-600')">
													{if $percentage > 0}+{/if}{$percentage|number:2} %
												</div>
											{/if}
											<span class="mt-2 inline-flex items-center rounded-md bg-{$color}-50 px-2 py-1 text-xs font-medium text-{$color}-700 ring-1 ring-inset ring-{$color}-700/10">
												{$state->getLabel()}
											</span>
										{else}
											<span class="inline-flex items-center rounded-md bg-gray-50 px-2 py-1 text-xs font-medium text-gray-600 ring-1 ring-inset ring-gray-500/10">
												{$state->getLabel()}
											</span>
										{/if}
									</td>
								{/foreach}
							</tr>
						{/foreach}
						</tbody>
					</table>
				</div>

				<div class="flex flex-wrap gap-3 border-t border-gray-200 bg-gray-50 px-4 py-3 text-xs text-gray-600 sm:px-6">
					<span class="inline-flex items-center gap-1.5"><span class="size-2 rounded-full bg-green-500"></span> Podhodnocená</span>
					<span class="inline-flex items-center gap-1.5"><span class="size-2 rounded-full bg-blue-500"></span> Férová cena</span>
					<span class="inline-flex items-center gap-1.5"><span class="size-2 rounded-full bg-red-500"></span> Nadhodnocená</span>
					<span class="inline-flex items-center gap-1.5"><span class="size-2 rounded-full bg-yellow-500"></span> Neutrální</span>
					<span class="inline-flex items-center gap-1.5"><span class="size-2 rounded-full bg-gray-400"></span> Nelze vypočítat</span>
				</div>
			</div>
		</details>
	{else}
		<div class="rounded-xl bg-white px-6 py-12 text-center shadow-sm ring-1 ring-gray-900/5">
			<p class="text-sm text-gray-500">Nejsou dostupná žádná data valuačních modelů.</p>
		</div>
	{/if}
</div>
