{parameters Nette\Forms\Controls\SelectBox $component, string $errorClass = ''}

{embed './searchableSelect.latte', id: (string) $component->getHtmlId(), searchable: $component->getOption('searchable') !== false}
	{block control}
		{$component->getControl()->addAttributes([
			'class' => 'sr-only form-control show-hidden-error' . $errorClass,
			'x-ref' => 'control',
			'tabindex' => -1,
			'aria-hidden' => 'true',
		])}
	{/block}
{/embed}
