{varType App\UI\Control\Datagrid\Action\IDatagridAction $action}
{varType App\Doctrine\Entity $item}

{parameters
    App\UI\Control\Datagrid\Action\IDatagridAction $action,
    App\Doctrine\Entity $item
}

<a href="{plink $action->getDestination(), (expand) $action->formatParametersForAction($item)}"
   n:class="$action->isAjax() ? 'ajax',
        'inline-flex items-center gap-1.5 rounded-md border border-transparent px-2.5 py-1.5 text-xs font-semibold text-white shadow-xs transition hover:brightness-95 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600',
        'bg-' . $action->getColor() . '-600'"
        {if $action->getConfirmation() !== null}
            onclick="return confirm({$action->getConfirmation()})"
        {/if}
>
    {if $action->getIcon() !== null}
        {renderSvg $action->getIcon(), ['class' => 'h-3.5 w-3.5']}
    {/if}
    {$action->getLabel()}
</a>
