{templateType App\Dashboard\UI\DashboardTemplate}

{block #content}
	<div x-data="dashboard('{link content}')" :aria-busy="loading.toString()" aria-busy="true">
		<div x-show="loading" role="status" class="rounded-2xl bg-white px-5 py-6 shadow-sm ring-1 ring-gray-900/5 sm:px-6">
			<div class="flex items-center gap-3 text-sm font-medium text-gray-600">
				{renderSvg App\UI\Icon\SvgIcon::SPINNER->value, ['class' => 'h-5 w-5 shrink-0', 'stroke' => 'currentColor', 'aria-hidden' => 'true']}
				<span>Načítání přehledu portfolia…</span>
			</div>
			<p class="mt-2 text-sm text-gray-500">Menu můžete používat už během načítání.</p>
		</div>

		<div x-show="error" x-cloak role="alert" class="rounded-2xl bg-white px-5 py-6 shadow-sm ring-1 ring-gray-900/5 sm:px-6">
			<p class="text-sm text-gray-700">Přehled portfolia se nepodařilo načíst.</p>
			<button @click="load()" :disabled="loading" type="button" class="mt-3 rounded-lg bg-blue-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600">
				Zkusit znovu
			</button>
		</div>

		<div x-html="html"></div>
		<noscript>
			<p class="mt-4 text-sm text-gray-700">Pro načtení přehledu portfolia je potřeba povolit JavaScript.</p>
		</noscript>
	</div>
{/block}
