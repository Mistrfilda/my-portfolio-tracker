{templateType App\OAuth2\Http\AuthorizationPage}
<!DOCTYPE html>
<html lang="cs" class="h-full bg-blue-700">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<meta name="robots" content="noindex, nofollow">
	<title>Povolení přístupu — My Portfolio Tracker</title>
	{webpackCss 'admin'}
</head>
<body class="min-h-full bg-blue-700 text-gray-900 antialiased">
<main class="flex min-h-screen flex-col justify-center px-4 py-10 sm:px-6 sm:py-12 lg:px-8">
	<header class="mx-auto w-full max-w-lg text-center">
		{renderSvg App\UI\Icon\SvgIcon::CHART_BAR_SQUARE->value, ['class' => 'mx-auto h-16 w-16 text-white', 'aria-hidden' => 'true']}
		<h1 class="mt-4 text-3xl font-extrabold tracking-tight text-white">My portfolio tracker</h1>
		<p class="mt-2 text-sm text-blue-100">Připojení aplikace k vašemu účtu</p>
	</header>

	<section aria-labelledby="authorization-heading" class="mx-auto mt-8 w-full max-w-lg rounded-xl bg-white px-6 py-8 shadow-lg sm:px-10">
		<h2 id="authorization-heading" class="text-xl font-semibold text-gray-900">Povolit přístup aplikaci</h2>
		<p class="mt-1 break-words text-lg font-semibold text-blue-700">{$clientName}</p>
		<p class="mt-3 text-sm leading-6 text-gray-600">
			Přihlaste se účtem My Portfolio Tracker a potvrďte požadovaná oprávnění.
		</p>

		<div class="mt-6 rounded-lg border border-blue-100 bg-blue-50 p-4">
			<h3 class="text-sm font-semibold text-blue-900">Požadovaná oprávnění</h3>
			<ul class="mt-3 space-y-3">
				<li n:foreach="$scopeLabels as $label" class="flex items-start gap-3 text-sm leading-6 text-gray-700">
					{renderSvg App\UI\Icon\SvgIcon::CHECK_CIRCLE->value, ['class' => 'mt-0.5 h-5 w-5 shrink-0 text-blue-600', 'aria-hidden' => 'true']}
					<span class="min-w-0 break-words">{$label}</span>
				</li>
			</ul>
		</div>

		<div n:if="$error !== null" role="alert" class="mt-6 flex items-start gap-3 rounded-md bg-red-50 p-4 text-sm leading-6 text-red-800">
			{renderSvg App\UI\Icon\SvgIcon::X_CIRCLE->value, ['class' => 'mt-0.5 h-5 w-5 shrink-0 text-red-500', 'aria-hidden' => 'true']}
			<p>{$error}</p>
		</div>

		<form method="post" action="{$action}" class="mt-6 space-y-5">
			<input type="hidden" name="transaction" value="{$transaction}">
			<div>
				<label for="username" class="block text-sm font-medium text-gray-700">Uživatelské jméno</label>
				<input id="username" name="username" type="text" autocomplete="username" required maxlength="255"
					class="mt-2 block w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-base text-gray-900 shadow-xs focus:border-blue-500 focus:outline-hidden focus:ring-2 focus:ring-blue-500 sm:text-sm">
			</div>
			<div>
				<label for="password" class="block text-sm font-medium text-gray-700">Heslo</label>
				<input id="password" name="password" type="password" autocomplete="current-password" required maxlength="4096"
					class="mt-2 block w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-base text-gray-900 shadow-xs focus:border-blue-500 focus:outline-hidden focus:ring-2 focus:ring-blue-500 sm:text-sm">
			</div>
			<div class="space-y-3 pt-1">
				<button type="submit" name="decision" value="approve"
					class="flex min-h-11 w-full items-center justify-center rounded-md border border-transparent bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white shadow-xs hover:bg-blue-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600">
					Přihlásit se a povolit přístup
				</button>
				<button type="submit" name="decision" value="deny" formnovalidate
					class="flex min-h-11 w-full items-center justify-center rounded-md border border-gray-300 bg-white px-4 py-2.5 text-sm font-medium text-gray-700 shadow-xs hover:bg-gray-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600">
					Zamítnout
				</button>
			</div>
		</form>
	</section>
</main>
</body>
</html>
