parameters:
	database:
		dbname: my-portfolio-app-tracker-tests

# General application tests do not require a running Redis server.
redis:
	cache:
		enabled: false
	sessions:
		enabled: false
	locks:
		enabled: false

services:
	# Replace the entire definition so the disabled cache is not referenced.
	redisGc!: [false]

# Debug panels retain containers and query traces across test cases.
di:
	debugger: false

dbal:
	debug:
		panel: false

application:
	debugger: false

routing:
	debugger: false

security:
	debugger: false

monolog:
	hook:
		fromTracy: false
		toTracy: false
	channel:
		default:
			handlers!:
				- Monolog\Handler\NullHandler()
